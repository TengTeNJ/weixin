/* 容器与基础 */
.home-container {
    padding: 24rpx;
    background: #ffffff;
    font-family: "PingFang SC", "Helvetica Neue", Arial;
}

/* 标题行：左右对齐在一行 */
.title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18rpx;
}

.title-left {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
}

.title-right {
    display: flex;
    align-items: center;
}

.more-text {
    color: #7B7B7B;
    font-size: 24rpx;
    margin-right: 6rpx;
}

.more-icon {
    width: 20rpx;
    height: 22rpx;
}

/* 场馆卡片（图片 + 距离徽章） */
.venue-card {
    position: relative;
    border-radius: 18rpx;
    overflow: hidden;
    margin-bottom: 12rpx;
}

.venue-img {
    width: 100%;
    height: 300rpx;
    display: block;
}

.venue-distance {
    position: absolute;
    top: 14rpx;
    right: 14rpx;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    padding: 6rpx 14rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
}

/* 场馆信息行 */
.venue-info-row {
    display: flex;
    align-items: center;
    margin: 12rpx 0 26rpx 0;
}

.map-icon {
    width: 18rpx;
    height: 18rpx;
    margin-right: 10rpx;
}

.venue-name {
    font-size: 28rpx;
    color: #222;
}

.venue-status {
    font-size: 22rpx;
    color: #fff;
    background: #ff7a00;
    padding: 4rpx 10rpx;
    border-radius: 12rpx;
    margin-left: 12rpx;
}

/* 用户信息卡：左右布局 */
.user-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff6f0;
    padding: 20rpx;
    border-radius: 18rpx;
    margin-bottom: 20rpx;
}

.user-left {
    display: flex;
    align-items: center;
}

.avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
}

.user-meta {
    margin-left: 18rpx;
}

.nickname {
    font-weight: 500;
    font-size: 34rpx;
    color: #181818;
    display: block;
}

.user-right {
    text-align: right;
}

.balance-label {
    font-size: 22rpx;
    color: #888;
    display: block;
}

.balance-value {
    font-size: 30rpx;
    color: #ff7a00;
    font-weight: 700;
    margin-top: 6rpx;
}

/* 功能区：左右两栏，左大 右竖排两项 */
.feature-row {
    display: flex;
    gap: 18rpx;
    margin-bottom: 18rpx;
}

/* 左侧大按钮 */
.feature-left {
    flex: 1;
    border-radius: 16rpx;
    background: rgba(233, 100, 21, 0.15);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 460rpx;
    /* 左侧高 */
    box-shadow: 0 8rpx 18rpx rgba(255, 122, 0, 0.12);
}

.feature-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 16rpx;
}

.avatar-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;      /* 确保图片也是圆形 */
  }

.feature-title {
    margin-top: 70rpx;
    font-size: 40rpx;
    color: #BE5517;
    font-weight: 700;
}

/* 右侧竖排两项 */
.feature-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.feature-top,
.feature-bottom {
    flex: 1;
    border-radius: 16rpx;
    background: #fff6f0;
    display: flex;
    align-items: center;
    padding: 20rpx;
    justify-content: space-between;
    box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.04);
}

.small-icon {
    width: 150rpx;
    height: 150rpx;
}

.small-title {
    font-size: 40rpx;
    color: #BE5517;
    font-weight: 700;
}

/* 私教行： 左文案 + 右两个小头像 */
.private-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 114rpx;
    background: rgba(233, 100, 21, 0.15);
    border-radius: 10rpx 10rpx 10rpx 10rpx;
}

.private-text {
    margin-left: 60rpx;
    font-size: 40rpx;
    color: #BE5517;
    font-weight: 600;
}

.private-right {
    display: flex;
    gap: 12rpx;
    align-items: center;
    margin-right: 60rpx;
}

.coach-avatar {
    width: 90rpx;
    height: 90rpx;
    border-radius: 50%;
    border: 2rpx solid #fff;
    box-shadow: 0 6rpx 12rpx rgba(0, 0, 0, 0.06);
}

.user-info {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32rpx 32rpx;
    border-bottom: 1rpx solid #eee;
    box-sizing: border-box;
}

.avatar {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}

.user-text {
    margin-left: 44rpx;
    flex: 1;
}


.phone {
    font-weight: 300;
    font-size: 20rpx;
    color: #181818;
    display: flex;
}

.phone-image{
    width: 20rpx;
    height: 26rpx;
    margin-right: 12rpx;
}


.header-text {
    font-size: 24rpx;
}

.circle-avatar-button {
    width: 120rpx;
    /* 直径 */
    height: 120rpx;
    /* 与宽度相同 */
    border-radius: 50%;
    /* 关键属性：50%为圆形 */
    padding: 0;
    /* 移除默认内边距 */
    margin: 0;
    line-height: normal;
    /* 重置行高 */
    background: transparent;
    /* 透明背景 */
    border: 1rpx solid #ddd;
    /* 可选边框 */
    overflow: hidden;
    /* 防止内容溢出 */
    display: flex;
    justify-content: center;
    align-items: center;
}

.top-right {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.balance {
    color: #E96415;
    font-weight: 400;
    font-size: 20rpx;
}

.text-div{
    display: flex;
    align-items: center;
}

.text-image{
    margin-left: 12rpx;
    width: 32rpx;
    height: 16rpx;
}