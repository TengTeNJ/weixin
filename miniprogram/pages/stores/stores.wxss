.venue-page {
    background: #f5f5f5;
    min-height: 100vh;
}

/* 顶部筛选栏 */
.filter-bar {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    background: #fff;
    padding: 20rpx 30rpx;
    border-bottom: 1rpx solid #eee;
}

.filter-item {
    display: flex;
    align-items: center;
    font-size: 28rpx;
    color: #333;
    margin-right: 64rpx;
}

.city-name {
    margin-right: 10rpx;
}

.arrow-icon {
    width: 20rpx;
    height: 20rpx;
    margin-left: 8rpx;
}

.sort {
    display: flex;
    align-items: center;
    gap: 10rpx;
}

.sort-icons {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-left: 6rpx;
}

.triangle-up,
.triangle-down {
    width: 0;
    height: 0;
    border-left: 8rpx solid transparent;
    border-right: 8rpx solid transparent;
}

.triangle-up {
    border-bottom: 10rpx solid #181818;
    margin-bottom: 4rpx;
}

.triangle-down {
    border-top: 10rpx solid #181818;
}

.active.triangle-up {
    border-bottom-color: #ff6a00;
}

.active.triangle-down {
    border-top-color: #ff6a00;
}

/* 场馆卡片 */
.venue-list {
    padding: 18rpx 32rpx 18rpx 32rpx;
    box-sizing: border-box; /* ⭐关键！让padding计入宽度 */
}

.venue-card {
    background: #fff;
    border-radius: 4rpx;
    overflow: hidden;
    margin-bottom: 18rpx;
    box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.venue-img {
    width: 100%;
    height: 274rpx;
    object-fit: cover;
}

.venue-info {
    padding: 32rpx;
}

.info-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10rpx;
}

.venue-name {
    font-weight: 500;
    font-size: 28rpx;
    color: #181818;
}

.distance {
    display: flex;
    align-items: center;
    color: #ff6a00;
    font-size: 26rpx;
}

.location-icon {
    width: 18rpx;
    height: 22rpx;
    margin-right: 6rpx;
}

.venue-address {
    font-weight: 300;
    font-size: 18rpx;
    color: #181818;
}