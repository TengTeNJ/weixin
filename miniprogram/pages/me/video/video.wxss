.video-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: black;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .video-player {
    width: 100%;
    height: 100%;
  }
  
  .close-btn {
    position: absolute;
    top: 60rpx;
    right: 40rpx;
    font-size: 60rpx;
    color: white;
    z-index: 10000;
    opacity: 0.8;
  }
  