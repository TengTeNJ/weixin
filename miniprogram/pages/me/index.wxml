<view class="container">
    <!--顶部图片-->
    <view class="top-image">
        <image src="/images/mine/top.png" class="top-image-class" mode="heightFix"></image>
    </view>
    <!-- 头像 + 用户信息 -->
    <view class="user-info">
        <!--头像-->
        <button open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" class="circle-avatar-button">
            <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" class="avatar-image"></image>
            <text wx:else class="header-text">设置头像</text>
        </button>

        <!-- <image class="avatar" src="{{userInfo.avatarUrl || '/assets/icons/default-avatar.png'}}"></image> -->
        <view class="user-text">
            <view class="nickname" bindtap="openNicknamePopup">{{userInfo.nickName || '未登录'}}</view>
            <!--手机号-->
            <view wx:if="{{userInfo.phoneNumber}}" class="phone">
                <image src="/images/home/phone.png" class="phone-image" mode="aspectFit"></image>
                <view> {{userInfo.phoneNumber ?  userInfo.phoneNumber : '未绑定手机号'}}</view>
            </view>
            <button wx:else open-type="getPhoneNumber" size="mini" bindgetphonenumber="onGetPhoneNumber" class="hidden-btn">授权登录</button>
        </view>
        <view class="balance">余额 ￥{{balance}}</view>
    </view>
    <!-- 获取手机号隐藏按钮（必须用户点击触发）-->
    <!-- 功能入口 -->
    <view class="grid-container">
        <block wx:for="{{featureList}}" wx:key="index">
            <view class="grid-item" data-index="{{index}}" bind:tap="onClickGrid">
                <image class="grid-icon" src="{{item.icon}}" mode="heightFix"></image>
                <text class="grid-text">{{item.text}}</text>
            </view>
        </block>
    </view>
    <!-- 下方列表入口 -->
    <view class="list-container">
        <block wx:for="{{listItems}}" wx:key="index">
            <view class="list-item" data-index="{{index}}" bind:tap="toNextPage">
                <view class="left">
                    <image class="list-icon" src="{{item.icon}}"></image>
                    <text class="list-title">{{item.title}}</text>
                </view>
                <image class="arrow" src="/images/mine/arrow-right.png" mode="heightFix"></image>
            </view>
        </block>
    </view>
    <!-- 昵称弹窗 -->
<view wx:if="{{showPopup}}" class="popup-mask">
  <view class="popup-box">
    <view class="popup-title">修改昵称</view>
    <view class="old-name">当前昵称：{{userInfo.nickName}}</view>
    <input 
      class="input"
      placeholder="请输入新的昵称"
      value="{{newNickname}}"
      bindinput="onNicknameInput"
    />
    <view class="btn-row">
      <button class="btn-cancel" bindtap="closePopup">取消</button>
      <button class="btn-confirm" bindtap="confirmNickname">确定</button>
    </view>
  </view>
</view>

 <!-- 底部版本号入口 -->
 <view class="version-entry" bindtap="showVersion">
    当前版本: {{version}}
  </view>
</view>