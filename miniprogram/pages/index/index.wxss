.container {
    background: #fff;
    padding: 64rpx 32rpx;
}

.top-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 22rpx;
    box-sizing: border-box;
}

.top-left {
    display: flex;
    flex-direction: column;
}

.logo {
    width: 390rpx;
    height: 34rpx;
}

/*地图行容器*/
.map-container {
    display: flex;
    align-items: center;
    margin-top: 12rpx;
}

.map {
    width: 16rpx;
    height: 22rpx;
    margin-right: 12rpx;
}

.hall-name {
    color: #7B7B7B;
    font-size: 20rpx;
    font-weight: 300;
}

.top-right {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.phone-icon {
    width: 24rpx;
    height: 32rpx;
}

.phone-text {
    font-weight: 400;
    font-size: 20rpx;
    color: #333;
    margin-top: 6rpx;
}

.banner {
    width: 100%;
    height: 280rpx;
    margin-top: 20rpx;
    margin-bottom: 64rpx;
    border-radius: 16rpx;
    overflow: hidden;
}

.banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}






/* 外层包裹，控制左右 32rpx */
.menu-wrapper {
    padding: 0 32rpx;
    width: 100%;
    box-sizing: border-box;
}

/* menu 容器，固定宽度 + 平均分布 */
.menu-row {
    display: flex;
    justify-content: space-between;
    width: 100%;
}

/* 每个菜单项 */
.menu-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 140rpx;
    /* 建议值 */
}

.menu-icon {
    width: 60rpx;
    height: 60rpx;
    margin-bottom: 16rpx;
}

.menu-text {
    font-size: 24rpx;
    margin-top: 8rpx;
    color: #333;
}

.section-title {
    font-size: 28rpx;
    font-weight: bold;
    margin: 20rpx 0 10rpx;
}

.scroll-x-wrapper {
    width: 100%;
    overflow-x: scroll;
    white-space: nowrap;
}

.scroll-content {
    display: flex;
    flex-direction: row;
}

.booking-card {
    flex-shrink: 0;
    /* 保证宽度不被压缩 */
    width: 140rpx;
    margin-right: 20rpx;
    background-color: #EBEBEB;
    border-radius: 16rpx;
    padding: 20rpx;
    text-align: center;
}

.booking-date {
    font-weight: 400;
    font-size: 28rpx;
    color: #181818;
}

.booking-time {
    font-weight: 400;
    font-size: 20rpx;
    color: #181818;
}

.booking-price {
    font-size: 24rpx;
    color: #FF6A00;
}

.match-scroll {
    display: flex;
    white-space: nowrap;
    padding-bottom: 20rpx;
}

.match-card {
    width: 650rpx;
    height: 272rpx;
    overflow: hidden;
    margin-right: 24rpx;
    flex-shrink: 0;
}

.match-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10rpx;
}
.gray-line{
    background-color: #D5D5D5;
    height: 1rpx;
    margin-top: 28rpx;
    margin-bottom: 12rpx;

}
.next {
    display: flex;
    align-items: center;
    justify-content: center;
}

.next-image {
    margin-left: 12rpx;
    height: 22rpx;
}