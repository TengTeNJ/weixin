.container {
    padding-bottom: 120rpx;
    /* 留出底部悬浮栏空间 */

}

/* 1. 日期横滑条 */
.date-scroll {
    display: flex;
    flex-direction: row;
    background: white;
    padding: 20rpx 0;
    white-space: nowrap;
    border-bottom: 1px solid #eee;
    height: 100rpx;
}

.date-item {
    width: 100rpx;
    text-align: center;
    font-size: 24rpx;
}

.date-week {
    color: #666;
}

.date-day {
    width: 60rpx;
    height: 60rpx;
    margin: 10rpx auto 0;
    line-height: 60rpx;
    border-radius: 50%;
    background: #f0f0f0;
}

/* 2. 主体内容区域 */
.main-body {
    width: 100%;
    display: flex;
    flex-direction: row;
    height: calc(100vh - 240rpx);
}

.venue-menu {
    width: 270rpx;
    background: #f9f9f9;
    flex-shrink: 0;
}

.venue-item {
    padding: 30rpx 0;
    text-align: center;
    font-size: 26rpx;
    position: relative;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.triangle {
    font-size: 20rpx;
    color: #999;
    margin-left: 6rpx;
}

.venue-item-active {
    background: #FFF2E5;
    color: #FF5A00;
    border-left-color: #FF5A00;
}

.time-slot-scroll {
    background: #EBEBEB;
    padding: 20rpx;
    flex-grow: 1;
    /* 占据剩余空间 */
}

.time-slot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
    padding: 20rpx;
    border-radius: 12rpx;
    background: #f3f3f3;
    font-size: 28rpx;
}

.time-slot .price {
    font-weight: 500;
    font-size: 24rpx;
    color: #181818;
}
.selected-time-text {
    font-weight: 500;
    font-size: 24rpx;
    color: #FFFFFF;
    text-align: left;
    font-style: normal;
    text-transform: none;
}

/* 3. 底部悬浮栏 */
.bottom-bar {
    position: fixed;
    bottom: 40rpx;
    left: 0;
    width: calc(100% - 64rpx);
    height: 100rpx;
    background: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 30rpx;
    /* box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1); */
    z-index: 10;
}

.notice {
    color: #999;
    font-size: 24rpx;
}

.book-btn {
    background: #FF5A00;
    color: #fff;
    padding: 20rpx 40rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
}