    border-radius: 20px 20px 20px 20px;
    border: 1px solid #7B7B7B;
    font-weight: 300;
    font-size: 30rpx;
    color: #7B7B7B;
}

.check-order {
    padding: 20rpx 58rpx;
    border-radius: 20px 20px 20px 20px;
    border: 1px solid #E96415;
    font-weight: 300;
    font-size: 30rpx;
    color: #E96415;
    text-align: center;
}