/* pages/booking/success/index.wxss */
.container {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.success {
    margin-top: 120rpx;
}

.success-image {
    height: 106rpx;
    margin-bottom: 8rpx;
}

.success-text {
    font-weight: 400;
    font-size: 28rpx;
    color: #181818;
    text-align: left;
    font-style: normal
}

.two-button {
    display: flex;
    margin-top: 128rpx;
}

.back-home {
