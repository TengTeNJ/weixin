.container {
    align-items: center;
    padding-bottom: 120rpx;
    /* 避免被底部栏遮住 */
}

.venue-image {
    margin-top: 100rpx;
    width: calc(100% - 200rpx);
    object-fit: cover;
    margin-bottom: 36rpx;
}

.venue-name {
    text-align: center;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
}

.venue-address {
    text-align: center;
    font-size: 24rpx;
    color: #888;
    margin-bottom: 20rpx;
}

.selected-time-list {
    width: calc(100% - 64rpx);
}

.time-item {
    display: flex;
    justify-content: space-between;
    background-color: #ffe6d9;
    padding: 28rpx 72rpx;
    margin-bottom: 16rpx;
    font-size: 26rpx;
}

.rule-price-row {
    width: calc(100% - 64rpx);
    display: flex;
    justify-content: space-between;
    padding: 40rpx 0rpx;
    font-size: 26rpx;
    border-bottom: 1rpx solid #eee;
}

.user-info {
    width: calc(100% - 64rpx);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 72rpx 30rpx;
    border-bottom: 1rpx solid #eee;
    font-size: 26rpx;
}

.phone-box {
    display: flex;
    align-items: center;
}

.user-phone {
    margin-right: 20rpx;
}

.edit-btn {
    color: #1aad19;
    font-size: 24rpx;
}

.booking-notice {
    text-align: center;
    padding: 40rpx 30rpx;
    color: #999;
    font-size: 24rpx;
    border-top: 1rpx solid #eee;
}

.notice-title {
    display: block;
    margin-bottom: 10rpx;
    font-weight: bold;
}

.bottom-bar {
    position: fixed;
    bottom: 0;
    width: 100%;
    height: 170rpx;
    background-color: #fff;
    border-top: 1rpx solid #eee;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 30rpx;
    box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
    box-sizing: border-box;
}

.total-amount {
    font-weight: 400;
    font-size: 12px;
    color: #181818;
}

.total-money {
    font-weight: 400;
    font-size: 14px;
    color: #E96415;
}

.pay-btn {
    background-color: #ff6a00;
    color: #fff;
    font-size: 28rpx;
    padding: 16rpx 40rpx;
    border-radius: 50rpx;
    line-height: 1;
}